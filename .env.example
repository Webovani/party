# Party — Docker settings. Copy to `.env` and edit; `docker compose` reads it.
#
#   cp .env.example .env
#
# Everything here is also passed into the containers, so the PARTY_* knobs below
# are the same ones documented in config/party.yml. Container-internal paths
# (music at /music, cache at /data/cache, DB host `db`) are pinned by
# docker-compose.yml and are NOT settable here.
#
# It is read by a NATIVE run too (bin/dev, bin/rails, rspec — dotenv-rails loads
# it in development and test), so one file configures both deployments. Nothing
# in it is required except SECRET_KEY_BASE, and that only in production/Docker.

# ---------------------------------------------------------------- required ---

# Rails needs this in production. Generate one and paste it in:
#   docker compose run --rm --no-deps web bin/rails secret
SECRET_KEY_BASE=

# Host directory holding the music library. Mounted read-only at /music.
#
# OPTIONAL, and EMPTY BY DEFAULT — the app then runs YouTube-only: no Library
# tab, no browsing, search asks YouTube alone, and local tracks left over in the
# database become unreachable (they are refused at add time rather than parking
# the player on a file that isn't there). /music is an empty volume; filling
# MUSIC_DIR in and running `party:scan` is all it takes to turn the library on.
MUSIC_DIR=
# Same thing for a native (non-Docker) run — Docker derives it from MUSIC_DIR,
# outside Docker set the path here.
PARTY_MUSIC_DIR=

# ------------------------------------------------------------------- audio ---

# How mpv reaches the speakers. See docs/DOCKER.md ("Audio").
#   pulse  — bind-mount the host's PulseAudio/PipeWire socket (default, desktop)
#   alsa   — talk to /dev/snd directly (add -f docker-compose.alsa.yml)
#
# Host PulseAudio/PipeWire socket. `echo $XDG_RUNTIME_DIR/pulse/native` on the host.
PULSE_SOCKET=/run/user/1000/pulse/native
# Host PulseAudio cookie; only used by some server configs, harmless otherwise.
# Defaults to $HOME/.config/pulse/cookie on the machine running compose.
PULSE_COOKIE=

# The container runs as this uid:gid. It MUST match the owner of PULSE_SOCKET
# (i.e. the desktop user) or PulseAudio will refuse the connection.
PUID=1000
PGID=1000

# ALSA only (docker-compose.alsa.yml): gid of the host's `audio` group.
#   getent group audio
AUDIO_GID=29

# mpv audio device. Blank = mpv's default.
#   pulse: leave blank, or e.g. pulse/alsa_output.pci-0000_00_1f.3.analog-stereo
#   alsa:  e.g. alsa/hw:0,0   (list them: docker compose exec player mpv --audio-device=help)
PARTY_AUDIO_DEVICE=
# Extra mpv audio filter chain applied at launch. Blank = none (per-track
# loudness gain does the levelling).
PARTY_AUDIO_FILTER=

# --------------------------------------------------------------- web / net ---

# Host port the UI is published on.
WEB_PORT=3008

# Which host interface to publish on. Blank = all of them. No authentication, so
# this is the access control:
#   WEB_BIND=192.168.1.10   LAN address only
#   WEB_BIND=127.0.0.1      this machine only (proxy in front)
WEB_BIND=

# ---------------------------------------------------------------- database ---

# Used by both the postgres container and the app.
POSTGRES_USER=party
POSTGRES_PASSWORD=party
POSTGRES_DB=party_production

# NATIVE runs only (in Docker these are pinned to the `db` service above).
# All blank = the local PostgreSQL over its unix socket as the current OS user,
# which is what a stock install gives you. Set what differs on your box.
PARTY_DB_HOST=
PARTY_DB_PORT=
PARTY_DB_USER=
PARTY_DB_PASSWORD=
# Postgres is not published to the host; reach it with
#   docker compose exec db psql -U party party_production
# (uncomment the `ports:` line under `db` in docker-compose.yml to change that,
# on a port your host's own PostgreSQL is not already using).

# ------------------------------------------------------- party behaviour ------

# Queue fairness / limits
PARTY_VOTES_TO_SKIP=2
PARTY_MAX_QUEUE_LENGTH=30
PARTY_MAX_QUEUE_PER_USER=20
PARTY_PRECACHE_AHEAD=3
# A queued track at least this long is "filler": plays only when nothing else
# waits, and is interrupted (position saved) when someone queues a real song.
PARTY_FILLER_MIN_MS=720000

# Loudness normalisation (every track is measured once with ffmpeg ebur128)
PARTY_LOUDNESS_TARGET=-20
PARTY_LOUDNESS_MAX_GAIN=0
PARTY_LOUDNESS_MIN_GAIN=-20
PARTY_LOUDNESS_BASS_CORRECTION=0.5
PARTY_LOUDNESS_HIGHPASS_HZ=200
# Show per-track LUFS/gain badges in the queue (for retuning by ear).
PARTY_LOUDNESS_DEBUG=false

# ----------------------------------------------------------------- runtime ---

# Schema creation on boot: auto = only the web role does it (default), true, false.
PARTY_DB_PREPARE=auto

RAILS_LOG_LEVEL=info
RAILS_MAX_THREADS=5
JOB_CONCURRENCY=1
TZ=Europe/Prague
