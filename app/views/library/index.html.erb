<%= turbo_frame_tag "search_results" do %>
  <%= render "shared/scope", scope: current_browse_scope, listing: true %>
  <div class="browse-head">
    <div class="browse-modes">
      <%= link_to "Artists", library_path(browse: "artists"),
            class: class_names("mode", active: @mode == :artists), data: { turbo_frame: "search_results" } %>
      <%= link_to "Folders", library_path(browse: "folders"),
            class: class_names("mode", active: @mode == :folders), data: { turbo_frame: "search_results" } %>
    </div>
    <span class="count muted"><%= @library_total %> tracks</span>
  </div>

  <% if @library_total.zero? %>
    <p class="muted">No local tracks indexed yet.</p>
  <% else %>
    <nav class="breadcrumb">
      <% @breadcrumb.each_with_index do |c, i| %>
        <% if i.positive? %><span class="sep">›</span><% end %>
        <% if c[:params] %>
          <%= link_to c[:label], library_path(c[:params]), data: { turbo_frame: "search_results" } %>
        <% else %>
          <span class="here"><%= c[:label] %></span>
        <% end %>
      <% end %>
    </nav>

    <% if @add %>
      <%= button_to "＋ Add all these to the queue", @add[:url], params: @add[:params],
            class: "add-all", form: { class: "inline" } %>
    <% end %>

    <% if @entries&.any? %>
      <ul class="browse-list">
        <%= render partial: "shared/browse_row", collection: @entries, as: :entry %>
      </ul>
    <% end %>

    <% if @tracks&.any? %>
      <ul class="results">
        <%= render partial: "shared/result_card",
                   collection: @tracks.map { |t| track_to_result(t) }, as: :result %>
      </ul>
    <% end %>

    <% if @entries&.empty? && @tracks&.empty? %>
      <p class="muted">Nothing here.</p>
    <% end %>
  <% end %>
<% end %>
