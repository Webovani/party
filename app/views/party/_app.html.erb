<main class="app" data-controller="connection">
  <header class="topbar">
    <%# Targets the frame, like the ⌂ tab: the brand sits outside search_results,
        but a full-page visit here would re-render the whole shell for what is
        the same "search everywhere" navigation. %>
    <%= link_to root_path, class: "brand", title: "Search everywhere",
          data: { turbo_frame: "search_results" } do %>🎉 Party<% end %>
    <span class="conn" data-connection-target="badge" hidden></span>
    <div class="me">
      <span class="nick"><%= current_nick %></span>
      <%= button_to "Leave", session_path, method: :delete, class: "linkbtn", form: { class: "inline" } %>
    </div>
  </header>

  <div class="scroll">
    <section class="search">
      <% scope = @scope || current_browse_scope %>
      <div id="search-controls">
        <%# Starting point only — search_controller flips this per submission:
            "advance" when entering or leaving a search (so Back returns to what
            you were browsing, and the empty state is its own step), "replace"
            while refining a non-empty query (so a debounced keystroke doesn't
            stack an entry each). Defaults to advance: if JS is dead there is no
            search-as-you-type to stack entries anyway. %>
        <%= form_with url: search_path, method: :get, id: "search-form",
              data: { controller: "search", turbo_frame: "search_results",
                      turbo_action: "advance" } do |f| %>
          <div class="search-input-wrap" id="search-input-wrap">
            <%= f.search_field :q, placeholder: search_placeholder(scope),
                  autocomplete: "off", value: params[:q],
                  data: { search_target: "input", action: "input->search#submit input->search#toggleClear" } %>
            <button type="button" class="search-clear" data-search-target="clear"
                    data-action="search#clearQuery" aria-label="Clear search"
                    <%= "hidden" if params[:q].blank? %>>✕</button>
          </div>
          <%# Server-rendered from the URL, then kept in step by the scope
              controller during frame navigation (which doesn't re-render this). %>
          <div id="search-scope-fields">
            <% if scope %>
              <%= hidden_field_tag :browse, scope[:browse], id: nil %>
              <% %i[artist album path].each do |key| %>
                <%= hidden_field_tag key, scope[key], id: nil if scope[key].present? %>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
      <%# turbo-action=advance: browsing writes itself into the URL, so
          back/forward and link-sharing work. Only navigation re-renders this
          frame. %>
      <turbo-frame id="search_results" data-turbo-action="advance">
        <%= render "shared/frame_content" %>
      </turbo-frame>
    </section>

    <%# Queue and player are frames with their own `src`, fetched and reloaded
        independently of what is being browsed. See PartyController. %>
    <section class="queue">
      <turbo-frame id="queue" src="<%= queue_region_path %>"></turbo-frame>
    </section>
  </div>

  <footer class="player-bar">
    <turbo-frame id="now-playing" src="<%= now_playing_region_path %>"></turbo-frame>
    <turbo-frame id="player-volume" src="<%= volume_region_path %>"></turbo-frame>
  </footer>
</main>
