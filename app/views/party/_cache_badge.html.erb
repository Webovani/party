<% if track.youtube? %>
  <% case track.cache_status %>
  <% when "ready" %>
    <span class="badge ok">cached</span>
  <% when "pending" %>
    <span class="badge wait">caching…</span>
  <% when "error" %>
    <span class="badge err" title="<%= track.last_error %>">failed</span>
  <% else %>
    <span class="badge">queued</span>
  <% end %>
<% end %>
