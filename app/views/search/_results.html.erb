<% scope   = local_assigns[:scope] %>
<% entries = local_assigns[:entries] || [] %>
<%# No "type to search…" hint here: the input's placeholder already says exactly
    that, from the same scope_search_target helper. %>
<% unless query.blank? %>
  <% if entries.empty? && sections.all? { |s| s[:results].empty? } %>
    <p class="muted">No results<%= " in #{scope[:label]}" if scope %> for “<%= query %>”.</p>
  <% else %>
    <% if entries.any? %>
      <h3 class="source-head"><%= entry_group_label(scope) %></h3>
      <ul class="browse-list">
        <%= render partial: "shared/browse_row", collection: entries, as: :entry %>
      </ul>
    <% end %>

    <% sections.each do |section| %>
      <% next if section[:results].empty? %>
      <h3 class="source-head">
        <% if scope %>Songs<% else %><%= section[:source] == "local" ? "Local library" : "YouTube" %><% end %>
      </h3>
      <ul class="results">
        <%= render partial: "shared/result_card", collection: section[:results], as: :result %>
      </ul>
    <% end %>
  <% end %>
<% end %>
