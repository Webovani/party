<%= render "shared/scope", scope: @scope, listing: true %>
<h3 class="source-head">
  <span>Recently played</span>
  <%= link_to "↓ CSV", history_export_path, class: "export-link",
        title: "Download the full play history", data: { turbo: false } %>
</h3>
<% if @tracks.empty? %>
  <p class="muted">Nothing has played yet.</p>
<% else %>
  <ul class="results">
    <%= render partial: "shared/result_card",
               collection: @tracks.map { |t| track_to_result(t) }, as: :result %>
  </ul>
<% end %>
