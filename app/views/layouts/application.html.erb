<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || document_title(@player, @current_item) %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Party">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#0f0f14">
    <%# Broadcast page refreshes morph the DOM in place (preserves scroll & permanents) %>
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
    <%# No snapshot cache. Browsing advances the URL from inside a turbo-frame, and
        Turbo swaps the frame content BEFORE running the visit that updates history —
        so the snapshot it caches under the URL you are leaving already contains the
        content of the page you moved to. Going back then replayed the wrong step.
        Every browse URL renders itself completely server-side (see
        ApplicationController#render_frame_or_page), so restoring by re-fetching is
        both correct and cheap on a LAN. %>
    <meta name="turbo-cache-control" content="no-cache">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <%# Every client subscribes to the shared party stream for live morphing %>
    <%= turbo_stream_from "party" %>

    <%# Toasts survive morphs (turbo-permanent) so per-actor messages aren't wiped %>
    <div id="toasts" class="toasts" data-turbo-permanent>
      <% flash.each do |type, message| %>
        <%= render "shared/toast", message: message, type: (type == "alert" ? "alert" : "notice") %>
      <% end %>
    </div>

    <%= yield %>
  </body>
</html>
